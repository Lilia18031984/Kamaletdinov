    def add_movie(self):
        """Добавляет новый фильм"""
        # Получение данных
        title = self.title_entry.get().strip()
        genre = self.genre_combo.get()
        year_str = self.year_entry.get().strip()
        rating_str = self.rating_entry.get().strip()
        
        # Валидация названия
        if not title:
            messagebox.showwarning("Ошибка", "Введите название фильма!")
            return
        
        # Валидация жанра
        if genre == "Выберите жанр":
            messagebox.showwarning("Ошибка", "Выберите жанр фильма!")
            return
        
        # Валидация года
        if not year_str:
            messagebox.showwarning("Ошибка", "Введите год выпуска!")
            return
        
        try:
            year = int(year_str)
        except ValueError:
            messagebox.showwarning("Ошибка", f"'{year_str}' — это не число!\nВведите корректный год.")
            self.year_entry.delete(0, tk.END)
            return
        
        if year < 1888 or year > 2030:
            messagebox.showwarning("Ошибка", "Год должен быть от 1888 (год выхода первого фильма) до 2030!")
            self.year_entry.delete(0, tk.END)
            return
        
        # Валидация рейтинга
        if not rating_str:
            messagebox.showwarning("Ошибка", "Введите рейтинг фильма!")
            return
        
        try:
            rating = float(rating_str)
        except ValueError:
            messagebox.showwarning("Ошибка", f"'{rating_str}' — это не число!\nВведите число от 0 до 10.")
            self.rating_entry.delete(0, tk.END)
            return
        
        if rating < 0 or rating > 10:
            messagebox.showwarning("Ошибка", "Рейтинг должен быть от 0 до 10!")
            self.rating_entry.delete(0, tk.END)
            return
        
        # Добавление фильма
        movie = {
            "title": title,
            "genre": genre,
            "year": year,
            "rating": rating
        }
        
        self.movies.append(movie)
        # Сортируем по названию
        self.movies.sort(key=lambda x: x["title"])
        self.save_movies()
        self.update_table()
        self.update_statistics()
        
        # Очистка полей
        self.title_entry.delete(0, tk.END)
        self.genre_combo.set("Выберите жанр")
        self.year_entry.delete(0, tk.END)
        self.rating_entry.delete(0, tk.END)
        
        self.status_label.config(text=f"✅ Фильм добавлен: {title}", fg="#4ecdc4")
        self.window.after(3000, lambda: self.status_label.config(text="💡 Готов к работе", fg="#888888"))
        
        self.title_entry.focus()
    
    def delete_movie(self):
        """Удаляет выбранный фильм"""
        selected = self.movie_tree.selection()
        if not selected:
            messagebox.showwarning("Ошибка", "Выберите фильм для удаления!")
            return
        
        item = selected[0]
        values = self.movie_tree.item(item, "values")
        title = values[0]
        
        if messagebox.askyesno("Подтверждение", f"Удалить фильм '{title}'?"):
            # Находим и удаляем фильм
            for i, movie in enumerate(self.movies):
                if movie["title"] == title:
                    self.movies.pop(i)
                    break
            
            self.save_movies()
            self.update_table()
            self.update_statistics()
            self.apply_filter()  # Переприменяем фильтр
            self.status_label.config(text=f"🗑️ Фильм удалён: {title}", fg="#ff6b6b")
            self.window.after(3000, lambda: self.status_label.config(text="💡 Готов к работе", fg="#888888"))
    
    def apply_filter(self):
        """Применяет фильтрацию фильмов"""
        filter_genre = self.filter_genre.get()
        filter_year_min_str = self.filter_year_min.get().strip()
        filter_year_max_str = self.filter_year_max.get().strip()
        
        filtered = self.movies.copy()
        
        # Фильтр по жанру
        if filter_genre != "Все":
            filtered = [m for m in filtered if m["genre"] == filter_genre]
        
        # Фильтр по году
        if filter_year_min_str:
            try:
                year_min = int(filter_year_min_str)
                filtered = [m for m in filtered if m["year"] >= year_min]
            except ValueError:
                messagebox.showwarning("Ошибка", "Неверное значение минимального года!")
                return
        
        if filter_year_max_str:
            try:
                year_max = int(filter_year_max_str)
                filtered = [m for m in filtered if m["year"] <= year_max]
            except ValueError:
                messagebox.showwarning("Ошибка", "Неверное значение максимального года!")
                return
        
        # Обновление таблицы
        self.update_table(filtered)
        
        # Статус
        self.status_label.config(text=f"🔍 Найдено {len(filtered)} фильмов", fg="#f39c12")
        self.window.after(3000, lambda: self.status_label.config(text="💡 Готов к работе", fg="#888888"))
    
    def reset_filter(self):
        """Сбрасывает фильтр"""
        self.filter_genre.set("Все")
        self.filter_year_min.delete(0, tk.END)
        self.filter_year_max.delete(0, tk.END)
        
        self.update_table()
        self.status_label.config(text="🔄 Фильтр сброшен", fg="#4ecdc4")
        self.window.after(3000, lambda: self.status_label.config(text="💡 Готов к работе", fg="#888888"))
    
    def update_table(self, movies_list=None):
        """Обновляет таблицу фильмов"""
        # Очищаем таблицу
        for item in self.movie_tree.get_children():
            self.movie_tree.delete(item)
        
        if movies_list is None:
            movies_list = self.movies
        
        # Добавляем фильмы
        for movie in movies_list:
            # Форматирование рейтинга
            rating_display = f"{movie['rating']:.1f}" if isinstance(movie['rating'], float) else f"{movie['rating']}"
            stars = "⭐" * min(5, int(movie['rating'] / 2))
            rating_text = f"{rating_display} {stars}"
            
            self.movie_tree.insert("", "end", values=(
                movie["title"],
                movie["genre"],
                movie["year"],
                rating_text
            ))
    
    def update_statistics(self):
        """Обновляет статистику"""
        if not self.movies:
            self.total_label.config(text="Всего фильмов: 0")
            self.avg_rating_label.config(text="Средний рейтинг: 0")
            self.highest_rated_label.config(text="Лучший фильм: —")
            return
        
        total = len(self.movies)
        ratings = [m["rating"] for m in self.movies]
        avg_rating = sum(ratings) / len(ratings)
        
        # Находим фильм с наивысшим рейтингом
        best_movie = max(self.movies, key=lambda x: x["rating"])
        
        self.total_label.config(text=f"Всего фильмов: {total}")
        self.avg_rating_label.config(text=f"Средний рейтинг: {avg_rating:.1f}")
        self.highest_rated_label.config(text=f"Лучший фильм: {best_movie['title']} (⭐{best_movie['rating']})")
    
    def on_closing(self):
        """Обработка закрытия окна"""
        if self.save_movies():
            self.window.destroy()
    
    def run(self):
        """Запуск приложения"""
        self.window.mainloop()

# Запуск программы
